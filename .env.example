MONGO_URI=mongodb://localhost:27017
MONGO_DB=nysc_keffi
JWT_SECRET=change-me-to-a-long-random-string
JWT_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Cloudinary (authenticated/private delivery is used for all biometric images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Face recognition: none | rekognition  (none => every attendance goes to manual review; nothing is faked)
FACE_PROVIDER=none
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_MATCH_THRESHOLD=90
FACE_REVIEW_THRESHOLD=75
# Default geofence (editable by Camp Director in-app). VERIFY the real Keffi camp coordinates on site.
CAMP_LAT=0
CAMP_LON=0
CAMP_RADIUS_M=500
MAX_GPS_ACCURACY_M=100
# Confirm the official call-up number format with NYSC and tighten this
CALLUP_REGEX=^[A-Z0-9/\-]{6,25}$
SELFIE_RETENTION_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=ChangeMe!2026
# Liveness: none | pose_challenge (requires FACE_PROVIDER=rekognition). Two frames: frontal, then head turned.
LIVENESS_MODE=none
LIVENESS_PAIR_THRESHOLD=70
# Web Push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
